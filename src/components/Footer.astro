---
import { safeExternalUrl, site } from "../data/site";

const year = new Date().getFullYear();
const github = safeExternalUrl(site.socials.github);
const linkedin = safeExternalUrl(site.socials.linkedin);
---

<footer class="bg-ink text-mist">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-10 md:px-6"
  >
    <p class="font-display text-sm">
      © {year} {site.name}.
    </p>
    <div class="flex items-center gap-4">
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="inline-flex text-mist/80 no-underline transition hover:text-mist"
          >
            <img
              src="/images/icons/github.svg"
              alt=""
              width="22"
              height="22"
              class="size-[22px]"
            />
          </a>
        )
      }
      {
        linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="inline-flex text-mist/80 no-underline transition hover:text-mist"
          >
            <img
              src="/images/icons/linkedin.svg"
              alt=""
              width="22"
              height="22"
              class="size-[22px]"
            />
          </a>
        )
      }
    </div>
  </div>
</footer>
