---
import { nav, safeExternalUrl, site } from "../data/site";

const mailto = safeExternalUrl(`mailto:${site.email}`);
const pathname = Astro.url.pathname;
const onHome = pathname === "/" || pathname === "";
const onProject = pathname.startsWith("/projects/");

function navHref(id: string): string {
  return onHome ? `#${id}` : `/#${id}`;
}

const homeHref = onHome ? "#home" : "/#home";
const initialActive = onProject ? "projects" : onHome ? "home" : null;
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-line bg-mist md:fixed md:inset-x-0 md:flex md:justify-center md:border-0 md:bg-transparent md:px-3 md:pt-3 md:opacity-0 md:-translate-y-2 md:pointer-events-none md:transition-[opacity,transform] md:duration-300 md:ease-out md:data-[scrolled=true]:opacity-100 md:data-[scrolled=true]:translate-y-0 md:data-[scrolled=true]:pointer-events-auto"
  data-scrolled="false"
>
  <div
    class="relative mx-auto flex min-h-12 w-full max-w-6xl items-center justify-between gap-2 px-4 py-2 md:mx-0 md:min-h-0 md:w-fit md:max-w-none md:justify-center md:gap-1 md:rounded-full md:border md:border-line md:bg-mist/95 md:px-2 md:py-1 md:shadow-sm md:backdrop-blur-md"
  >
    <a
      href={homeHref}
      data-nav-home
      class="inline-flex h-10 shrink-0 items-center justify-center px-1 font-display text-sm font-semibold text-ink no-underline md:hidden"
      aria-label={`${site.name} — home`}
    >
      {site.initials}
    </a>

    <nav
      id="primary-nav"
      aria-label="Primary"
      class="absolute inset-x-0 top-full z-40 hidden border-b border-line bg-mist px-4 py-2 shadow-sm md:static md:inset-auto md:flex md:border-0 md:bg-transparent md:p-0 md:shadow-none"
    >
      <ul
        class="mx-auto flex w-full max-w-6xl flex-col gap-0.5 md:mx-0 md:w-auto md:flex-row md:flex-nowrap md:items-center md:gap-0"
      >
        {
          nav.map((item) => {
            const active = initialActive === item.id;
            return (
              <li class="w-full md:w-auto md:shrink-0">
                <a
                  href={navHref(item.id)}
                  data-nav-link={item.id}
                  {...(active ? { "aria-current": "true" as const } : {})}
                  class:list={[
                    "block rounded-md px-3 py-2.5 text-center font-display text-sm font-medium no-underline transition-colors md:inline-block md:rounded-full md:px-2.5 md:py-1.5 md:text-xs",
                    active
                      ? "bg-accent text-white"
                      : "text-muted hover:text-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-1.5">
      {
        mailto && (
          <a
            href={mailto}
            class="hidden h-10 w-auto shrink-0 items-center whitespace-nowrap rounded-none bg-ink px-3 font-display text-xs font-medium text-white no-underline transition hover:bg-ink/90 md:inline-flex md:h-auto md:rounded-full md:px-2.5 md:py-1.5 md:text-[11px] md:leading-none"
          >
            Say hello
          </a>
        )
      }
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex size-10 shrink-0 items-center justify-center rounded-sm border border-ink/15 text-ink md:hidden"
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg
          id="nav-icon-open"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
        <svg
          id="nav-icon-close"
          class="hidden size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  let abort: AbortController | null = null;

  function initHeaderNav() {
    abort?.abort();
    abort = null;

    const header = document.getElementById("site-header");
    const toggle = document.getElementById("nav-toggle");
    const nav = document.getElementById("primary-nav");
    const iconOpen = document.getElementById("nav-icon-open");
    const iconClose = document.getElementById("nav-icon-close");
    const home = document.getElementById("home");
    const heroNav = document.getElementById("hero-nav");
    if (!toggle || !nav || !iconOpen || !iconClose) return;

    abort = new AbortController();
    const { signal } = abort;
    const mq = window.matchMedia("(min-width: 768px)");
    let scrollRaf = 0;

    signal.addEventListener("abort", () => {
      if (scrollRaf) {
        cancelAnimationFrame(scrollRaf);
        scrollRaf = 0;
      }
    });

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      nav.classList.toggle("hidden", !open);
      iconOpen.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
      document.dispatchEvent(
        new CustomEvent("nav-menu-toggle", { detail: { open } }),
      );
    };

    const setScrolled = (scrolled: boolean) => {
      if (!header) return;
      header.dataset.scrolled = scrolled ? "true" : "false";

      // Desktop floating pill: block focus/AT when visually hidden on hero.
      if (mq.matches && !scrolled) {
        header.setAttribute("inert", "");
      } else {
        header.removeAttribute("inert");
      }

      // When the floating pill is the active chrome, park hero nav for AT/focus.
      if (heroNav) {
        if (mq.matches && scrolled) {
          heroNav.setAttribute("inert", "");
          heroNav.setAttribute("aria-hidden", "true");
        } else {
          heroNav.removeAttribute("inert");
          heroNav.removeAttribute("aria-hidden");
        }
      }
    };

    /** Desktop: hide at top of page; show once scrolled (ignore stale section hash). */
    const syncScrollReveal = () => {
      if (!header) return;
      if (!mq.matches) {
        setScrolled(true);
        return;
      }
      if (!home) {
        setScrolled(true);
        return;
      }
      // Stale #section hashes must not keep the pill visible at scrollY === 0.
      setScrolled(window.scrollY > 40);
    };

    const scheduleScrollReveal = () => {
      if (scrollRaf) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = 0;
        syncScrollReveal();
      });
    };

    toggle.addEventListener(
      "click",
      () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      },
      { signal },
    );

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false), { signal });
    });

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") setOpen(false);
      },
      { signal },
    );

    const syncDesktop = () => {
      if (mq.matches) {
        setOpen(false);
        nav.classList.remove("hidden");
      } else if (toggle.getAttribute("aria-expanded") !== "true") {
        nav.classList.add("hidden");
      }
      syncScrollReveal();
    };
    mq.addEventListener("change", syncDesktop, { signal });
    window.addEventListener("scroll", scheduleScrollReveal, {
      passive: true,
      signal,
    });
    window.addEventListener("resize", scheduleScrollReveal, {
      passive: true,
      signal,
    });
    window.addEventListener("hashchange", syncScrollReveal, { signal });
    syncDesktop();
  }

  document.addEventListener("astro:page-load", initHeaderNav);
</script>
