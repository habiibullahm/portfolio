---
import { safeExternalUrl, site } from "../../data/site";

const mailto = `mailto:${site.email}`;
const github = safeExternalUrl(site.socials.github);
const linkedin = safeExternalUrl(site.socials.linkedin);
---

<section id="contact" data-section class="section-anchor border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
    <p class="font-mono text-xs tracking-widest text-muted">CONTACT</p>
    <h2 class="mt-2 text-2xl md:text-3xl">Want to ship something together?</h2>
    <p class="mt-4 max-w-xl text-muted">
      Reach out by email or LinkedIn — no public CV download, keep it simple.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={mailto}
        class="inline-flex rounded-md bg-accent px-5 py-3 font-display text-sm font-medium text-white no-underline hover:bg-accent/90"
      >
        {site.email}
      </a>
      {
        linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex rounded-md border border-ink/20 px-5 py-3 font-display text-sm font-medium text-ink no-underline hover:border-accent hover:text-accent"
          >
            LinkedIn
          </a>
        )
      }
      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex rounded-md border border-ink/20 px-5 py-3 font-display text-sm font-medium text-ink no-underline hover:border-accent hover:text-accent"
          >
            GitHub
          </a>
        )
      }
    </div>
  </div>
</section>
