---
import { safeExternalUrl, site } from "../../data/site";

const mailto = safeExternalUrl(`mailto:${site.email}`);
---

<section id="contact" data-section class="section-anchor">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
    <p class="font-mono text-xs tracking-widest text-muted">CONTACT</p>
    <h2 class="mt-2 text-2xl md:text-3xl">Want to ship something together?</h2>
    <p class="mt-4 max-w-xl text-muted">{site.contactBlurb}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      {
        mailto && (
          <a
            href={mailto}
            class="inline-flex items-center rounded-md bg-ink px-5 py-3 font-display text-sm font-medium text-white no-underline transition hover:bg-ink/90"
          >
            {site.email}
          </a>
        )
      }
    </div>
  </div>
</section>
