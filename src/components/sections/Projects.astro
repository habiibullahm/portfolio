---
import { getCollection } from "astro:content";
import { safeExternalUrl } from "../../data/site";

const projects = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" data-section class="section-anchor border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
    <p class="font-mono text-xs tracking-widest text-muted">PROJECTS</p>
    <h2 class="mt-2 text-2xl md:text-3xl">Things I've shipped</h2>

    <ul class="mt-12 space-y-12">
      {
        projects.map((project) => {
          const live = project.data.links?.live
            ? safeExternalUrl(project.data.links.live)
            : null;
          const repo = project.data.links?.repo
            ? safeExternalUrl(project.data.links.repo)
            : null;
          const imageSrc =
            project.data.image.startsWith("/") && !project.data.image.startsWith("//")
              ? project.data.image
              : null;
          if (!imageSrc) return null;
          return (
            <li class="grid gap-6 md:grid-cols-[1.2fr_1fr] md:items-center">
              <img
                src={imageSrc}
                alt={project.data.imageAlt}
                width="1200"
                height="720"
                class="w-full rounded-md object-cover"
                loading="lazy"
              />
              <div>
                <p class="font-mono text-xs tracking-wide text-muted">
                  {project.data.client} · {project.data.domain}
                </p>
                <h3 class="mt-2 text-xl md:text-2xl">{project.data.title}</h3>
                <p class="mt-3 text-muted">{project.data.outcome}</p>
                <div class="mt-4 flex flex-wrap gap-4 font-display text-sm">
                  {live && (
                    <a
                      href={live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent no-underline hover:underline"
                    >
                      Live
                    </a>
                  )}
                  {repo && (
                    <a
                      href={repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent no-underline hover:underline"
                    >
                      Code
                    </a>
                  )}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
