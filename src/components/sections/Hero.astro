---
import { safeExternalUrl, site } from "../../data/site";

const mailto = safeExternalUrl(`mailto:${site.email}`);
---

<section id="home" data-section class="section-anchor border-b border-line">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <p class="font-mono text-xs tracking-widest text-muted">{site.eyebrow}</p>
    <h1 class="mt-4 text-3xl leading-tight text-ink md:text-5xl">
      {site.statement}
      {" "}
      <em class="not-italic text-accent">{site.statementEmphasis}.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-base text-muted md:text-lg">{site.summary}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#projects"
        class="inline-flex items-center rounded-md bg-ink px-5 py-3 font-display text-sm font-medium text-white no-underline transition hover:bg-ink/90"
      >
        Explore projects
      </a>
      {
        mailto && (
          <a
            href={mailto}
            class="inline-flex items-center rounded-md border border-ink/20 bg-transparent px-5 py-3 font-display text-sm font-medium text-ink no-underline transition hover:border-accent hover:text-accent"
          >
            Email
          </a>
        )
      }
    </div>
  </div>
</section>
