---
import { nav, safeExternalUrl, site } from "../../data/site";

const mailto = safeExternalUrl(`mailto:${site.email}`);
const heroNav = nav.filter((item) => item.id !== "home");
---

<section
  id="home"
  data-section
  class="section-anchor relative overflow-hidden border-b border-line"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
    style="
      background:
        radial-gradient(ellipse 80% 60% at 15% 10%, color-mix(in srgb, var(--color-accent-soft) 70%, transparent), transparent 55%),
        radial-gradient(ellipse 50% 40% at 90% 20%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 50%),
        var(--color-mist);
    "
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-16 pt-6 md:px-6 md:pb-24 md:pt-8">
    <div class="flex items-center justify-between gap-3">
      <p class="min-w-0 font-mono text-xs tracking-widest text-muted">
        {site.eyebrow}
      </p>

      <nav
        id="hero-nav"
        aria-label="Sections"
        class="hidden shrink-0 md:block"
      >
        <ul class="flex items-center gap-3">
          {
            heroNav.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-nav-link={item.id}
                  title={item.label}
                  class="font-display text-[11px] font-medium tracking-wide text-muted no-underline transition-colors hover:text-ink"
                >
                  {item.short}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <h1
      class="hero-animate mt-4 font-display text-4xl font-semibold leading-tight text-ink md:text-6xl"
    >
      {site.name}
    </h1>
    <p
      class="hero-animate hero-animate-delay-1 mt-5 text-xl leading-snug text-ink md:mt-6 md:text-3xl"
    >
      {site.statement}
      {" "}
      <em class="not-italic text-accent">{site.statementEmphasis}.</em>
    </p>
    <p
      class="hero-animate hero-animate-delay-2 mt-5 max-w-2xl text-base text-muted md:text-lg"
    >
      {site.summary}
    </p>
    <div class="hero-animate hero-animate-delay-3 mt-8 flex flex-wrap gap-3">
      <a
        href="#projects"
        class="inline-flex items-center rounded-md bg-ink px-5 py-3 font-display text-sm font-medium text-white no-underline transition hover:bg-ink/90"
      >
        Selected work
      </a>
      {
        mailto && (
          <a
            href={mailto}
            class="inline-flex items-center rounded-md border border-ink/20 bg-transparent px-5 py-3 font-display text-sm font-medium text-ink no-underline transition hover:border-accent hover:text-accent"
          >
            Email
          </a>
        )
      }
    </div>
  </div>
</section>

<script>
  import "../../scripts/hero-replay.ts";
</script>
