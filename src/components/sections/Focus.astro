---
import { focusAreas } from "../../data/site";
---

<div id="focus" class="mt-14" aria-labelledby="focus-heading">
  <p class="font-mono text-xs tracking-widest text-muted">FOCUS</p>
  <h3 id="focus-heading" class="mt-2 text-xl md:text-2xl">
    Depth connected to shipping reality.
  </h3>
  <ul class="mt-8 grid gap-6 md:grid-cols-2">
    {
      focusAreas.map((item) => (
        <li class="border-t border-line pt-6">
          <h4 class="text-lg text-ink">{item.title}</h4>
          <p class="mt-2 text-muted">{item.blurb}</p>
        </li>
      ))
    }
  </ul>
</div>
