---
import { focusAreas } from "../../data/site";
---

<section
  id="focus"
  data-section
  class="section-anchor border-b border-line"
  aria-labelledby="focus-heading"
>
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
    <p class="font-mono text-xs tracking-widest text-muted">FOCUS</p>
    <h2 id="focus-heading" class="mt-2 text-2xl md:text-3xl">
      Depth connected to shipping reality.
    </h2>
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        focusAreas.map((item) => (
          <li class="border-t border-line pt-4">
            <h3 class="font-display text-lg text-ink">{item.title}</h3>
            <p class="mt-2 text-sm text-muted md:text-base">{item.blurb}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
